#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS  
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# LOAD SETTINGS
#=================================================
ynh_script_progression --message="Loading installation settings..." --weight=1

app=$YNH_APP_INSTANCE_NAME

domain=$(ynh_app_setting_get --app=$app --key=domain)
path_url=$(ynh_app_setting_get --app=$app --key=path)
admin=$(ynh_app_setting_get --app=$app --key=admin)
webserver_enabled=$(ynh_app_setting_get --app=$app --key=webserver_enabled)

#=================================================
# CHECK VERSION
#=================================================

upgrade_type=$(ynh_check_app_version_changed)

#=================================================
# BACKUP BEFORE UPGRADE THEN ACTIVE TRAP
#=================================================
ynh_script_progression --message="Backing up the app before upgrading..." --weight=1

ynh_backup_before_upgrade
ynh_clean_setup () {
    ynh_clean_check_starting
    ynh_restore_upgradebackup
}
ynh_abort_if_errors

#=================================================
# STANDARD UPGRADE STEPS
#=================================================

# Stop services
ynh_script_progression --message="Stopping systemd service..." --weight=1
ynh_systemd_action --service_name=$app --action="stop" --log_path="$data_dir/logs/freqtrade.log"

#=================================================
# UPGRADE FREQTRADE
#=================================================
ynh_script_progression --message="Upgrading Freqtrade..." --weight=15

pushd "$install_dir"
    # Upgrade Freqtrade in virtual environment
    ynh_exec_warn_less sudo -u $app $install_dir/venv/bin/pip install --upgrade freqtrade[complete]
popd

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression --message="Updating configuration..." --weight=1

# Preserve existing config, just update systemd
ynh_add_systemd_config

#=================================================
# NGINX CONFIGURATION
#=================================================

if [ $webserver_enabled -eq 1 ]; then
    ynh_script_progression --message="Upgrading NGINX configuration..." --weight=1
    ynh_add_nginx_config
fi

#=================================================
# USE LOGROTATE
#=================================================
ynh_script_progression --message="Upgrading logrotate configuration..." --weight=1

ynh_use_logrotate --logfile="$data_dir/logs/freqtrade.log" --non-append

#=================================================
# INTEGRATE SERVICE IN YUNOHOST
#=================================================
ynh_script_progression --message="Integrating service in YunoHost..." --weight=1

yunohost service add $app --description="Cryptocurrency trading bot" --log="$data_dir/logs/freqtrade.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression --message="Starting systemd service..." --weight=1

ynh_systemd_action --service_name=$app --action="start" --log_path="$data_dir/logs/freqtrade.log" --line_match="Starting freqtrade"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression --message="Upgrade of $app completed" --last